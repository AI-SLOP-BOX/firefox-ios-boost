{
  "manifest_version": 3,
  "name": "YouTube Boost (PiP + Background)",
  "short_name": "YT Boost",
  "version": "1.0.0",
  "description": "YouTubeにPiPボタンを追加し、バックグラウンド再生を維持する。広告ブロックは含まない (uBOL等と併用)。",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.music.youtube.com/*",
    "*://youtu.be/*",
    "*://*.youtube-nocookie.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon48.png"
    },
    "default_title": "YouTube Boost"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.music.youtube.com/*",
        "*://youtu.be/*",
        "*://*.youtube-nocookie.com/*"
      ],
      "js": ["content/youtube_boost.js"],
      "css": ["content/youtube_boost.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/page_guard.js"],
      "matches": [
        "*://*.youtube.com/*",
        "*://*.music.youtube.com/*",
        "*://youtu.be/*",
        "*://*.youtube-nocookie.com/*"
      ]
    }
  ]
}
